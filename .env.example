# Database (Neon PostgreSQL)
DATABASE_URL=postgres://user:pass@host/neondb?sslmode=require

# Auth — Cloudflare Access
# AUTH_MODE=cfaccess (set in deploy-cloud-run.sh, not needed locally unless testing CF Access)
# CF_ACCESS_TEAM_DOMAIN is set as env var in deploy-cloud-run.sh (not a secret)
CF_ACCESS_AUD=                          # Cloudflare Access Application AUD tag
JWT_SECRET=change-me-in-production      # Used for machine tokens (HS256)

# Cloudflare — Tunnel & DNS management
CLOUDFLARE_API_TOKEN=                   # API token with Zone:DNS:Edit + Tunnel permissions
CLOUDFLARE_ACCOUNT_ID=                  # Cloudflare account ID
CLOUDFLARE_ZONE_ID=                     # Zone ID for openclawmachines.com
CLOUDFLARE_KV_NAMESPACE_ID=             # KV namespace ID for OCM_ROUTES

# Cloudflare — Service Token (worker -> backend internal API)
CF_SERVICE_TOKEN_ID=                    # Service token ID (CF Access service auth)
CF_SERVICE_TOKEN_SECRET=                # Service token secret

# Agent communication
FC_AGENT_TOKEN=change-me-in-production
WORKSPACE_TOKEN_SECRET=change-me        # Shared secret for machine token signing

# Secret encryption (exactly 32 bytes — generate with: openssl rand -hex 16)
SECRET_ENCRYPTION_KEY=

# AI Provider keys (BYOK — users also set these per-machine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LiteLLM
LITELLM_MASTER_KEY=change-me-in-production

# Composio (optional — third-party app integrations: Gmail, Slack, GitHub, etc.)
# Get your consumer key from https://app.composio.dev → Settings → API Keys
COMPOSIO_CONSUMER_KEY=

# GCP
GCP_PROJECT=clarateach
GCP_ZONE=us-central1-b

# URLs
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGINS=http://localhost:5173

# Ports
PORT=8080
FRONTEND_PORT=5173
