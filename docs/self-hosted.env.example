# Self-hosted OCM operator env template.
# Values shown here are placeholders. Do not commit real secrets.

# Profile
CONTROL_PLANE_PROFILE=operator

# Public URLs
DATA_PLANE_DOMAIN=example.com
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com,https://example.com

# Operator bootstrap and browser cookie scope.
# COOKIE_DOMAIN may be left blank to derive it from DATA_PLANE_DOMAIN.
COOKIE_DOMAIN=.example.com
OCM_ADMIN_EMAILS=admin@example.com

# Database
DATABASE_URL=postgres://user:pass@db.example.com/ocm?sslmode=require

# OCM secrets
JWT_SECRET=replace-with-long-random-secret
SECRET_ENCRYPTION_KEY=replace-with-32-character-random-value
FC_AGENT_TOKEN=replace-with-agent-shared-secret

# Cloudflare account and zone
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_API_TOKEN=replace-with-api-token
CLOUDFLARE_KV_NAMESPACE_ID=replace-with-ocm-routes-kv-id

# Cloudflare Access service token for automation that crosses Access-protected
# hostnames. Leave unset if the corresponding endpoints are not behind Access.
CF_SERVICE_TOKEN_ID=
CF_SERVICE_TOKEN_SECRET=

# Human auth mode: choose firebase or cfaccess.
AUTH_MODE=firebase

# Firebase human auth
FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Cloudflare Access human auth
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Frontend Firebase values. Set these in the frontend build/runtime environment.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Frontend data plane. Prefer runtime platform config where available; keep this
# in sync with DATA_PLANE_DOMAIN for current frontend builds.
VITE_DATA_PLANE_DOMAIN=example.com
VITE_COOKIE_DOMAIN=.example.com
VITE_OCM_ADMIN_EMAILS=admin@example.com
VITE_API_URL=https://api.example.com/api

# Worker config/secrets. Set through wrangler config and wrangler secret.
# The current Worker consumes JWT_SECRET, CF_SERVICE_TOKEN_ID, and
# CF_SERVICE_TOKEN_SECRET as Worker secrets.
BASE_DOMAIN=example.com
# Set these only to distinct origin hostnames that are not covered by Worker routes.
FRONTEND_ORIGIN_HOST=
BACKEND_ORIGIN_HOST=
# The Worker expects an OCM_ROUTES KV binding configured in wrangler.toml.

# Optional artifact manifests controlled by the operator.
ROOTFS_GCS_MANIFEST=
AGENT_GCS_MANIFEST=
BROWSER_ROOTFS_GCS_MANIFEST=
HERMES_GCS_MANIFEST=
HERMES_ROOTFS_GCS_MANIFEST=
